{
  "name": "pi-promptsmith",
  "version": "0.4.0",
  "description": "Intent-aware prompt rewriter and execution-contract compiler for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-enhancer",
    "prompt-engineering",
    "coding-agent",
    "promptsmith",
    "ai"
  ],
  "license": "MIT",
  "author": "ayagmar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayagmar/pi-promptsmith.git"
  },
  "homepage": "https://github.com/ayagmar/pi-promptsmith#readme",
  "bugs": {
    "url": "https://github.com/ayagmar/pi-promptsmith/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/ayagmar/pi-promptsmith/master/promptsmith.gif"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --import=tsx --test ./test/*.test.ts",
    "smoke-test": "node --import=tsx ./scripts/smoke-test.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run smoke-test",
    "release:dry": "release-it --ci --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-ai": "^1.0.1",
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@earendil-works/pi-tui": "^1.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24",
    "release-it": "^21.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.8.1",
  "publishConfig": {
    "access": "public"
  }
}
